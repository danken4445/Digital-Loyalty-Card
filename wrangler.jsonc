{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "digital-loyalty-card",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding; service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "digital-loyalty-card"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://digital-loyalty-card.danken4445.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://oauwcwzkokdnotwjkihp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_5qsNQrkjB3uXty70WXT4Tw_2RIbeBOU",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFwoWKM0rFNNkGUg"
  },
  "previews": {
    "vars": {
      "NEXT_PUBLIC_SITE_URL": "https://digital-loyalty-card.danken4445.workers.dev",
      "NEXT_PUBLIC_SUPABASE_URL": "https://oauwcwzkokdnotwjkihp.supabase.co",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_5qsNQrkjB3uXty70WXT4Tw_2RIbeBOU",
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFwoWKM0rFNNkGUg"
    }
  }
}