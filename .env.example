# ==============================================================================
# THE CAFFEINE PLUG — NFC DIGITAL LOYALTY CARD
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any real secret keys to git.
# ==============================================================================

# Canonical site URL (production example: https://card.thecaffeineplug.ph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Configuration (safe for browser; obtained from `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-hosted-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY! Never prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-supabase-service-role-key

# HMAC Secret for 5-minute single-use reward redemption QR tokens (min 32 random bytes hex/base64)
REDEEM_TOKEN_SECRET=replace-with-at-least-32-character-random-secret-string

# Cloudflare Turnstile CAPTCHA (use Cloudflare documented test keys for local dev:
# Site key: 1x00000000000000000000AA | Secret key: 1x0000000000000000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis for per-IP and per-customer rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Google Identity Services (Displays your custom domain and brand on Google instead of supabase.co)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
